void Player::openBag()
{
    int i;
    
    cout << playerName << "'s inventory\n------------" << endl;
    for (i = 0; i < bag.size(); ++i)
    {
        if (i != 0 && i % 5 == 0)
        {
            cout << bag.at(i);
        }
        else
        {
            cout << bag.at(i) << " ";
        }
        
    }
    cout<<endl;
    cout<<"------------"<<endl;
}

void Player::addPotion(string itemName)
{
    bag.push_back(itemName);
}

void Player::usePotion(string itemName)
{
    if (itemName == "Health_Potion")
    {
        increaseHealth(20);
    }
    else if (itemName == "Attack_Potion")
    {
        increaseAttack(5);
    }
    else if (itemName == "Defense_Potion")
    {
        increaseDefense(5);
    }
    for (int i = 0; i < bag.size(); ++i)
    {
        if (bag.at(i) == itemName && bag.size() > 1)
        {
            string temp = bag.at(bag.size() - 1);
            bag.at(bag.size() - 1) = itemName;
            bag.pop_back();
            bag.at(i) = temp;
            break;
        }
        else if (bag.at(i) == itemName && i == bag.size() - 1)
        {
            bag.pop_back();
            break;
        }
        else
        {
            string temp = bag.at(bag.size() - 1);
            bag.at(bag.size() - 1) = itemName;
            bag.pop_back();
            break;
        }
    }
}
