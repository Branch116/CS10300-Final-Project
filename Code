void Events::Challenge(Adventure stage, Player &P, Dragon &dragonDEF){
    int sta = stage.getStage();
    
    
    
    //variable count1, the witch event will be deactivated if it's triggered three time
    //variable count2, the helpvillager will be deactivated if it's triggered seven time
    
    int c1 = 4;
    int c2 = rand() %6;
    int c3 = rand() %6;
    string select;
    if(sta != 5 && sta != 10 && sta != 15 && sta != 20){
        if(c2==0 || c2==1){
            c2 = rand()%6;
            if(c2 == 1) c2 = rand()%6;
        }
        
        if(c3==0 || c3==1){
            c3 = rand()%6;
            if(c3 == 1) c3 = rand()%6;
        }
        
        cout<<"Event 1: "<<NameOfChallenge.at(c1)<<endl;
        while(!TFchallenge.at(c2)) c2 = rand() %6;
        cout<<"Event 2: "<<NameOfChallenge.at(c2)<<endl;
        while(!TFchallenge.at(c3)) c3 = rand() %6;
        cout<<"Event 3: "<<NameOfChallenge.at(c3)<<endl;
        
        cout<<"Enter 1, 2, or 3 to select the event: ";
        cin>>select;
        cout<<endl;
        while(select != "1" && select != "2" && select != "3" && select != "S" && select != "s" && select != "B" && select != "b"){
            cout<<"Enter 1, 2, or 3 to select the event: ";
            cin>>select;
            cout<<endl;
        }
        if (!isalpha(select.at(0)))
        {
            cout << "You selected event " << select << ": ";
        }
        if(select == "1"){
            cout<<NameOfChallenge.at(c1)<<endl;
            Training(P);
        }
        else if(select == "2"){
            cout<<NameOfChallenge.at(c2)<<endl;
            if(NameOfChallenge.at(c2)=="Witch Game"){
                Witch(P);
                count1++;
                if(count1==3) TFchallenge.at(c2) = false;
            }
            else if(NameOfChallenge.at(c2)=="Lucky Coin"){
                LuckyCoin(P);
                TFchallenge.at(c2) = false;
            }
            else if(NameOfChallenge.at(c2)=="The Sword of the Warrior"){
                SwordOfTheWarrior(dragonDEF, P);
                TFchallenge.at(c2) = false;
            }
            else if(NameOfChallenge.at(c2)=="Monster Fighting"){
                MonsterFighting(P, stage);
            }
            else if(NameOfChallenge.at(c2)=="Training"){
                Training(P);
            }
            else{
                HelpVillager(P);
                count2++;
                if(count2==7) {
                    TFchallenge.at(c2) = false;
                    TFchallenge.at(2) = true;
                }
            }
        }
        else if (select == "S" || select == "s")
        {
            P.stats();
            cin>>select;
        }
        else if (select == "B" || select == "b")
        {
            P.openBag();
            cin>>select;
        }
        else {
            cout<<NameOfChallenge.at(c3)<<endl;
            if(NameOfChallenge.at(c3)=="Witch Game"){
                Witch(P);
                count1++;
                if(count1==3) TFchallenge.at(c3) = false;
            }
            else if(NameOfChallenge.at(c3)=="Lucky Coin"){
                LuckyCoin(P);
                TFchallenge.at(c3) = false;
            }
            else if(NameOfChallenge.at(c3)=="The Sword of the Warrior"){
                SwordOfTheWarrior(dragonDEF, P);
                TFchallenge.at(c3) = false;
            }
            else if(NameOfChallenge.at(c3)=="Monster Fighting"){
                MonsterFighting(P, stage);
            }
            else if(NameOfChallenge.at(c3)=="Training"){
                Training(P);
            }
            else{
                HelpVillager(P);
                count2++;
                if(count2==7){
                    TFchallenge.at(c3) = false;
                    TFchallenge.at(2) = true;
                }
                
            }
        }
    }
    
    else if(sta == 5 || sta == 10 || sta == 15){
        cout<<NameOfChallenge.at(6)<<endl;
        cout<<"Enter 1 to challenge the boss: ";
        cin>>select;
        cout<<endl;
        while(select != "1"){
            cout<<"Enter 1 to challenge the boss: ";
            cin>>select;
            cout<<endl;
        }
        Boss(P, stage);
        
        
    }
    else{
        cout<<NameOfChallenge.at(7)<<endl;
        cout<<"Enter 1 to enter the dragon's lair and challenge Nidhogg: ";
        cin>>select;
        cout<<endl;
        while(select != "1"){
            cout<<"Enter 1 to enter the dragon's lair and challenge Nidhogg: ";
            cin>>select;
            cout<<endl;
        }
        dragonDEF.DragonLair(P);
    }
}



void Events::combatMonster(Player &P){
    string playerSkill;
    double ap;
    string useItem;
    bool hasItem;
    cout<<"\nMonster's Stats\nMonster's HP: "<<MonsterHP<<"\nNonster's AP: "<<MonsterAP<<endl;

    while(MonsterHP>0 && P.getHealth()>0){
        MonsterDamage = MonsterAP;
        
        cout<<"\nThe monster is charging up..."<<endl;
        cout<<"\nEnter your skills: ";
        cin>>playerSkill;
        cout<<endl;
        while(playerSkill != "1" && playerSkill != "2" && playerSkill != "3"){
            cout<<"Enter your skills: ";
            cin>>playerSkill;
            cout<<endl;
        }
        if(playerSkill=="2"){
            MonsterDamage *= (1-P.getDefense()/100.0)*0.5;
            cout<<"You blocked half of the monster's damage."<<endl;
        }
        else if(playerSkill =="1"){
            cout<<"You choose to attack head-on!"<<endl;
            ap = P.getAttack();
            SetMonsterHP(MonsterHP - ap);
        }
        else if(playerSkill =="3"){
            if(P.bagFull()){
                cout<<"Enter a potion that you want to use: ";
                cin>>useItem;
                hasItem = P.hasPotion(useItem);
                cout<<endl;
                while(!hasItem){
                    cout<<"You don't have that potion.\nEnter a potion that you want to use: ";
                    cin>>useItem;
                    hasItem = P.hasPotion(useItem);
                    cout<<endl;
                }
                P.usePotion(useItem);
            }
            else {
                cout<<"Your bag contains no items."<<endl;
            }
            
        }
        
        cout<<"The monster dealt you "<<MonsterDamage<<" points of damage."<<endl;
        P.setHealth(P.getHealth()-MonsterDamage);
        if(P.getHealth()<=0){
            if(P.getLuckyCoin()) P.restoreHP();
            else{
                cout<<"You were defeated by the monster."<<endl;
                return;
            }
        }
        
        cout<<"\nMonster's Stats\nMonster's HP: "<<fixed<<setprecision(2)<<MonsterHP<<"\nNonster's AP: "<<MonsterAP<<endl;
