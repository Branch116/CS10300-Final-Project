        MonsterDamage = MonsterAP;
        cout<<"Your turn: ";
        cin>>playerSkill;
        cout<<endl;
        while(playerSkill != "1" && playerSkill != "2" && playerSkill != "3"){
            cout<<"Your turn: ";
            cin>>playerSkill;
            cout<<endl;
        }
        
        if(playerSkill=="2"){
            MonsterDamage *= (1-P.getDefense()/100.0)*0.5;
            cout<<"You chose to defend, but the monster didn't attack."<<endl;
        }
        else if(playerSkill =="1"){
            cout<<"You bravely cleave at the monster!"<<endl;
            ap = P.getAttack();
            SetMonsterHP(MonsterHP - ap);
        }
        else if(playerSkill =="3"){
            if(P.bagFull()){
                cout<<"Enter a potion that you want to use: ";
                cin>>useItem;
                hasItem = P.hasPotion(useItem);
                cout<<endl;
                while(!hasItem){
                    cout<<"You don't have that potion.\nEnter a potion that you want to use: ";
                    cin>>useItem;
                    hasItem = P.hasPotion(useItem);
                    cout<<endl;
                }
                P.usePotion(useItem);
            }
            else {
                cout<<"Your bag contains no items."<<endl;
            }
            
        }
        
        cout<<"\nYour Stats\nYour HP: "<<fixed<<setprecision(2)<<P.getHealth()<<"\nYour AP: "<<P.getAttack()<<"\nYour DEF: "<<P.getDefense()<<endl;
        P.openBag();
